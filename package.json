{
  "name": "react-native-shrinking-tab-bar",
  "version": "0.1.0",
  "description": "Floating pill tab bar for React Navigation and Expo Router that shrinks to icons on scroll. Fully customisable, runs on the UI thread.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-shrinking-tab-bar-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json",
    "./glass": {
      "react-native-shrinking-tab-bar-source": "./src/glass.tsx",
      "types": "./lib/typescript/src/glass.d.ts",
      "default": "./lib/module/glass.js"
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-shrinking-tab-bar-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "node --test test/*.test.mts && jest"
  },
  "keywords": [
    "react-native",
    "react-navigation",
    "expo-router",
    "bottom-tabs",
    "tab-bar",
    "tabbar",
    "floating-tab-bar",
    "collapsible",
    "shrink-on-scroll",
    "reanimated",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninadsutrave/react-native-shrinking-tab-bar.git"
  },
  "author": "Ninad Sutrave <ninadsutrave@gmail.com> (https://ninadsutrave.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ninadsutrave/react-native-shrinking-tab-bar/issues"
  },
  "homepage": "https://github.com/ninadsutrave/react-native-shrinking-tab-bar#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "babel-jest": "^30",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "expo-blur": "~57.0.3",
    "expo-glass-effect": "~57.0.5",
    "jest": "^30",
    "prettier": "^3.9.10",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.44.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.10.1",
    "test-renderer": "^1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@react-navigation/bottom-tabs": ">=7.0.0",
    "expo-blur": ">=14.0.0",
    "expo-glass-effect": ">=0.1.0",
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-reanimated": ">=3.6.0",
    "react-native-safe-area-context": ">=4.5.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint"
    ],
    "version": "0.64.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/bottom-tabs": {
      "optional": true
    },
    "expo-blur": {
      "optional": true
    },
    "expo-glass-effect": {
      "optional": true
    }
  },
  "sideEffects": false
}
